APP_NAME="be-keuangan"
PORT=3000
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/keuangan?retryWrites=true&w=majority&appName=<app-name>"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
